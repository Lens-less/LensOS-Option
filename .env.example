CRYPTO_OPTIONS_RUNTIME_PROFILE=production
CRYPTO_OPTIONS_API_MAX_WORKERS=8
CRYPTO_OPTIONS_API_REQUEST_TIMEOUT=15
# Sidecar-backed refresh stays outside the web process. When enabled, this
# path must exactly match crypto_options_report.snapshot_sidecar --output and already
# exist before the production API starts:
# CRYPTO_OPTIONS_API_SNAPSHOT_FIXTURE=C:/service-data/crypto-options/snapshot.json
# Read-only account evidence is collected by a separate sidecar. The API reads
# only the sanitized snapshot path and must not receive Deribit credentials:
# CRYPTO_OPTIONS_ACCOUNT_SNAPSHOT_FIXTURE=C:/service-data/crypto-options/account.json
# Sidecar-only environment (create an account:read + trade:read key; never grant
# read_write and never commit real values):
# DERIBIT_CLIENT_ID=
# DERIBIT_CLIENT_SECRET=
# DERIBIT_ACCOUNT_CURRENCY=BTC
# Operator-owned evidence paths. Historical data must be licensed/validated;
# the absence of a fixture makes POST /backtest/run return actionable HTTP 409.
# CRYPTO_OPTIONS_HISTORICAL_FIXTURE=C:/service-data/crypto-options/history.json
# CRYPTO_OPTIONS_BACKTEST_ARTIFACT_DIR=C:/service-data/crypto-options/backtests
# CRYPTO_OPTIONS_PAPER_LEDGER_PATH=C:/service-data/crypto-options/paper-ledger.json
CRYPTO_OPTIONS_MANUAL_APPROVAL_RUNBOOK=crypto_options_report/resources/manual-approval-runbook.md
# The sidecar CLI refresh interval defaults to 10 seconds (measured after each
# completed attempt); override it only with crypto_options_report.snapshot_sidecar
# --interval while preserving the report's 60-second freshness budget.
# Non-loopback binds must be placed behind an authenticated TLS reverse proxy:
# CRYPTO_OPTIONS_API_ALLOW_REMOTE=1
# Optional alert webhook HMAC secret; never pass the value on the command line:
# ALERT_WEBHOOK_SECRET=
