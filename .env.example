CRYPTO_OPTIONS_RUNTIME_PROFILE=production
CRYPTO_OPTIONS_API_MAX_WORKERS=8
CRYPTO_OPTIONS_API_REQUEST_TIMEOUT=15
# Sidecar-backed refresh stays outside the web process. When enabled, this
# path must exactly match tools.refresh_market_snapshot --output and already
# exist before the production API starts:
# CRYPTO_OPTIONS_API_SNAPSHOT_FIXTURE=C:/service-data/crypto-options/snapshot.json
# The sidecar CLI refresh interval defaults to 10 seconds (measured after each
# completed attempt); override it only with tools.refresh_market_snapshot
# --interval while preserving the report's 60-second freshness budget.
# Non-loopback binds must be placed behind an authenticated TLS reverse proxy:
# CRYPTO_OPTIONS_API_ALLOW_REMOTE=1
# Optional alert webhook HMAC secret; never pass the value on the command line:
# ALERT_WEBHOOK_SECRET=
