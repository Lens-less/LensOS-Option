{
  "name": "lensos-option-evidence-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit --pretty false && vite build",
    "build:public": "npm run sync:public-reason-codes && tsc --noEmit --pretty false && vite build --config vite.public.config.ts",
    "build:extension": "tsc -p tsconfig.extension.json --noEmit --pretty false && vite build --config vite.extension.config.ts",
    "build:all": "npm run build && npm run build:extension",
    "lint": "tsc --noEmit --pretty false --noUnusedLocals --noUnusedParameters",
    "sync:public-reason-codes": "node ./scripts/sync-public-reason-codes.mjs",
    "test": "vitest run",
    "test:public-bundle": "npm run sync:public-reason-codes && node ./scripts/assert-public-bundle-boundary.mjs",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
